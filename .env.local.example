# ─── Image / Price Search ────────────────────────────────────────────────────
# Serper.dev API key for Google Shopping price search
# Get free key at: https://serper.dev (2,500 free queries/month)
# If omitted, falls back to DuckDuckGo (no key required, lower quality)
SERPER_API_KEY=your_key_here

# ─── Price Check Scheduler ───────────────────────────────────────────────────
# How often to run the automated price check (default: 12 hours)
PRICE_CHECK_INTERVAL_HOURS=12

# ─── Push Notifications (Ntfy.sh) ───────────────────────────────────────────
# Topic name for push notifications when a price alert fires
# Create a free topic at https://ntfy.sh — pick any unique string
# Notifications are sent via POST to https://ntfy.sh/<NTFY_TOPIC>
# Leave commented to disable push notifications
# NTFY_TOPIC=mybuild-alerts-yourname

# ─── API Security ────────────────────────────────────────────────────────────
# Optional secret to protect state-modifying API routes (POST/DELETE)
# When set, all requests to /api/automations, /api/prices/trigger,
# /api/pc-photo, and /api/component-image must include:
#   x-api-key: <this value>
# Leave commented for local-only use (no authentication required)
# API_SECRET=change-me-to-a-strong-random-string

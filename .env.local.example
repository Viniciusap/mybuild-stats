# Serper.dev API key for Google Shopping price search
# Get free key at: https://serper.dev (2,500 free queries/month)
SERPER_API_KEY=your_key_here

# Price check interval in hours (default: 12)
PRICE_CHECK_INTERVAL_HOURS=12

# Optional: Ntfy.sh topic for push notifications on price alerts
# NTFY_TOPIC=your_topic_here
